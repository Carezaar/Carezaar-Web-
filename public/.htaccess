# Apache hosting (app.carezaar.com), the counterpart of public/_redirects and vercel.json.
# The app's screens (/intro, /sign-in, /main/matches, ...) are routes inside index.html, not
# files: without this, opening a link, a bookmark or reloading any screen but "/" answers
# "The requested URL was not found on this server." (client report, 3 Nov 2026).
Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Profile photos and the legal PDFs live on the API host, which sends no CORS headers;
  # the app reads them through its own origin (src/api/services.ts currentPhotoFile).
  <IfModule mod_proxy.c>
    RewriteRule ^(uploads/.*|terms_of_use\.pdf|privacy_policy\.pdf)$ https://new.carezaar.com/$1 [P,L]
  </IfModule>

  # Real files and folders are served as they are, and a missing file (a path with an
  # extension) stays a 404; every other path is a screen of the app.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]+$
  RewriteRule ^ index.html [L]
</IfModule>

# The build's hashed files (name-HASH.js/css) never change; the page itself and fixed-name
# files such as assets/warm.js are always checked again.
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
